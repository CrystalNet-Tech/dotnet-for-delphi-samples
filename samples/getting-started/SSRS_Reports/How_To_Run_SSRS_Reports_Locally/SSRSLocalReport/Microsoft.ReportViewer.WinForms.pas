procedure TLocalReport_SubreportProcessingHandler(sender: _ClrObject; e: _ClrEventArgs); stdcall;
var
	evtObject: TLocalReport;
 	evtArg: ISubreportProcessingEventArgs;
begin
	evtObject := TClrNotifyEvent.GetSource<TLocalReport>(sender);
	evtArg := TClrBaseObject.CreateInstance<TSubreportProcessingEventArgs>(e.EventParams.GetValue(1));
	if Assigned(evtObject) and Assigned(evtObject.FSubreportProcessing) then
		evtObject.FSubreportProcessing(evtObject, evtArg);
end;

function TLocalReport.Get_SubreportProcessing : TSubreportProcessingEventHandler;
begin
	Result := FSubreportProcessing;
end;

procedure TLocalReport.Set_SubreportProcessing(Value : TSubreportProcessingEventHandler);
var
	stdEvtHandler : TClrEventHandler;
begin
	stdEvtHandler := TLocalReport_SubreportProcessingHandler;
	if @Value <> Nil then
		RegisterEventCallBack('SubreportProcessing', @stdEvtHandler)
	else
		UnRegisterEventCallBack('SubreportProcessing', @stdEvtHandler);
	FSubreportProcessing := Value;
end;

